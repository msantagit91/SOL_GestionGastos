<Window x:Class="WPF_LoginForm.View.V_VentanaToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="320"
        Height="80"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">

    <Border CornerRadius="15"
            Background="#25283D"
            BorderBrush="#00D4FF"
            BorderThickness="2">

        <Grid>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="15">

                <TextBlock Text="✓"
                           Foreground="#00D4FF"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,10,0"/>

                <TextBlock x:Name="txtMensaje"
                           Foreground="White"
                           FontSize="14"
                           VerticalAlignment="Center"/>
            </StackPanel>

        </Grid>

    </Border>
</Window>
