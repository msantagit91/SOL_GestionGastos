<Window x:Class="WPF_LoginForm.View.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MainView"
        Height="550"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True">

    <Window.Resources>

        <Style x:Key="MenuButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Montserrat"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0,0,0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="HoverBorder"
                        Background="Transparent"
                        CornerRadius="8">

                            <Grid>

                                <!-- Barra Neon -->

                                <Border x:Name="Indicator"
                                Width="4"
                                Background="#DA34AE"
                                HorizontalAlignment="Left"
                                Opacity="0"
                                CornerRadius="2"/>

                                <ContentPresenter x:Name="contentPresenter"
                                          VerticalAlignment="Center"
                                          Margin="0"/>

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Hover -->

                            <Trigger Property="IsMouseOver"
                             Value="True">

                                <Setter TargetName="HoverBorder"
                                Property="Background"
                                Value="#20FFFFFF"/>

                                <Setter TargetName="Indicator"
                                Property="Opacity"
                                Value="1"/>

                                <Setter Property="Foreground"
                                Value="White"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <Border CornerRadius="10"
            BorderThickness="1">

        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#462AD8" Offset="0"/>
                <GradientStop Color="#DA34AE" Offset="0.5"/>
                <GradientStop Color="#8A16C1" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- MENU IZQUIERDO -->

            <Border Grid.Column="0"
                    CornerRadius="10,0,0,10">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.7">
                        <GradientStop Color="#24105F" Offset="0"/>
                        <GradientStop Color="#8A16C1" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <StackPanel Margin="0,20,0,0">

                    <!-- Logo -->


                    <Image Source="/View/LogoOficial3Version2.png"
                           Width="200" Height="144" Margin="0,-48,0,0" Stretch="UniformToFill"/>

                    <TextBlock Text="CONTROL DE GASTOS"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"
                               FontFamily="Montserrat"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,20"/>

                    <Separator Margin="20,0,20,20"/>

                    <!-- Dashboard -->

                    <Border Width="220"
                            Height="45"
                            HorizontalAlignment="Center"
                            Background="#31196D"
                            CornerRadius="8">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Background="#DA34AE"
                                    Grid.Column="0"
                                    CornerRadius="5,0,0,5"/>

                            <TextBlock Text="🏠 Dashboard"
                                       Grid.Column="1"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       Margin="15,0,0,0"/>

                        </Grid>

                    </Border>

                    <Button Content="🏠 Dashboard"
                    Style="{StaticResource MenuButtonStyle}"
                    Margin="15,8"/>

                    <Button Content="💰 Gastos"
                    Style="{StaticResource MenuButtonStyle}"
                    Margin="15,-4"/>

                    <Button Content="📁 Categorías"
                    Style="{StaticResource MenuButtonStyle}"
                    Margin="15,4"/>

                    <Button Content="👥 Usuarios"
                    Style="{StaticResource MenuButtonStyle}"
                    Margin="15,4"/>

                    <Button Content="📊 Reportes"
                    Style="{StaticResource MenuButtonStyle}"
                    Margin="15,4"/>

                    

                    <Separator Margin="20,5,20,10"/>
                    <Button x:Name="btnCerrarSesion"
        Content="🚪 Cerrar sesión"
        Height="45"
        Cursor="Hand"
        FontSize="14"
        FontFamily="Montserrat"
        Foreground="#FFBABA"
        BorderThickness="0">

                        <Button.Template>

                            <ControlTemplate TargetType="{x:Type Button}">

                                <Border x:Name="HoverBorder"
                    Background="Transparent"
                    CornerRadius="8">

                                    <Grid>

                                        <!-- Barra Neon -->

                                        <Border x:Name="Indicator"
                            Width="4"
                            Background="#DA34AE"
                            HorizontalAlignment="Left"
                            Opacity="0"
                            CornerRadius="2"/>

                                        <ContentPresenter VerticalAlignment="Center"
                                      HorizontalAlignment="Left"
                                      Margin="20,0,0,0"/>

                                    </Grid>

                                </Border>

                                <ControlTemplate.Triggers>

                                    <Trigger Property="IsMouseOver"
                         Value="True">

                                        <Setter TargetName="HoverBorder"
                            Property="Background"
                            Value="#20FFFFFF"/>

                                        <Setter TargetName="Indicator"
                            Property="Opacity"
                            Value="1"/>

                                        <Setter Property="Foreground"
                            Value="White"/>

                                    </Trigger>

                                </ControlTemplate.Triggers>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>
                </StackPanel>

            </Border>

            <!-- PANEL DERECHO -->

            <Border Grid.Column="1"
                    CornerRadius="0,10,10,0">

                <Border.Background>
                    <SolidColorBrush Color="#1C0E49"/>
                </Border.Background>

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->

                    <Grid Grid.Row="0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Bienvenido"
                                   Foreground="White"
                                   FontFamily="Montserrat"
                                   VerticalAlignment="Center"
                                   Margin="20,0,0,0"/>

                        <!-- Minimizar -->

                        <Button x:Name="btnMinimize"
                                Grid.Column="1"
                                BorderThickness="0"
                                Content="-"
                                Foreground="White"
                                FontSize="16"
                                Cursor="Hand"
                                Click="btnMinimize_Click" Grid.ColumnSpan="2" Margin="16,0,24,0">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Width="18"
                                            Height="18"
                                            CornerRadius="9"
                                            Background="#28AEED">

                                        <ContentPresenter
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    </Border>
                                </ControlTemplate>
                            </Button.Template>

                        </Button>

                        <!-- Cerrar -->

                        <Button x:Name="btnClose"
                                Grid.Column="2"
                                BorderThickness="0"
                                Content="X"
                                Foreground="White"
                                FontSize="12"
                                Cursor="Hand"
                                Click="btnClose_Click">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Width="18"
                                            Height="18"
                                            CornerRadius="9"
                                            Background="#DA34AE">

                                        <ContentPresenter
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    </Border>
                                </ControlTemplate>
                            </Button.Template>

                        </Button>

                    </Grid>

                    <!-- CONTENIDO -->

                    <Grid Grid.Row="1">

                        <ContentControl x:Name="MainContent"
                                        Margin="15"/>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </Border>

</Window>
