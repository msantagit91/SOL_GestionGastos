<UserControl x:Class="WPF_LoginForm.UserControls.UC_Gastos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WPF_LoginForm.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid Background="#1C0E49">

        <!-- Título -->

        <TextBlock Text="REGISTRO DE GASTOS"
                   Foreground="White"
                   FontSize="25"
                   FontWeight="SemiBold"
                   FontFamily="Montserrat"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,0"
                   VerticalAlignment="Top"/>

        <!-- Card Principal -->

        <Border Margin="10,55,10,10"
        Padding="25"
        CornerRadius="10"
        Background="#2A175E">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- FORMULARIO -->

                <Grid Grid.Row="0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- Descripción -->

                    <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="Descripción:"
                       Foreground="WhiteSmoke"
                       FontSize="15"
                       FontFamily="Montserrat"
                       VerticalAlignment="Center"/>

                    <TextBox Grid.Row="0"
                     Grid.Column="1"
                     x:Name="txtDescripcion"
                     Height="30"
                     FontSize="13"
                     Foreground="White"
                     CaretBrush="White"
                     Background="Transparent"
                     BorderBrush="DarkGray"
                     BorderThickness="0,0,0,2"
                     VerticalContentAlignment="Center"/>

                    <!-- Monto -->

                    <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="Monto:"
                       Foreground="WhiteSmoke"
                       FontSize="15"
                       FontFamily="Montserrat"
                       VerticalAlignment="Center"/>

                    <TextBox Grid.Row="1"
                     Grid.Column="1"
                     x:Name="txtMonto"
                     Height="30"
                     FontSize="13"
                     Foreground="White"
                     CaretBrush="White"
                     Background="Transparent"
                     BorderBrush="DarkGray"
                     BorderThickness="0,0,0,2"
                     VerticalContentAlignment="Center"/>

                    <!-- Categoría -->

                    <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Text="Categoría:"
                       Foreground="WhiteSmoke"
                       FontSize="15"
                       FontFamily="Montserrat"
                       VerticalAlignment="Center"/>

                    <ComboBox Grid.Row="2"
                      Grid.Column="1"
                      x:Name="cbCategoria"
                      Height="30"/>


                    <!-- Fecha -->

                    <TextBlock Grid.Row="3"
                       Grid.Column="0"
                       Text="Fecha:"
                       Foreground="WhiteSmoke"
                       FontSize="15"
                       FontFamily="Montserrat"
                       VerticalAlignment="Center"/>

                    <DatePicker Grid.Row="3"
                        Grid.Column="1"
                        x:Name="dpFecha"
                        Height="30"/>

                </Grid>

                <!-- BOTONES -->

                <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                    <Button x:Name="btnGuardar"
                    Content="💾 Guardar"
                    Width="120"
                    Height="40"
                    Margin="5"
                    Background="#6C63FF"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    FontFamily="Montserrat"
                    FontWeight="SemiBold" Click="btnGuardar_Click"/>

                    <Button x:Name="btnEditar"
                    Content="✏️ Editar"
                    Width="120"
                    Height="40"
                    Margin="5"
                    Background="#3B82F6"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    FontFamily="Montserrat"
                    FontWeight="SemiBold" Click="btnEditar_Click"/>

                    <Button x:Name="btnEliminar"
                    Content="🗑 Eliminar"
                    Width="120"
                    Height="40"
                    Margin="5"
                    Background="#EF4444"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    FontFamily="Montserrat"
                    FontWeight="SemiBold" Click="btnEliminar_Click"/>

                    <Button x:Name="btnLimpiar"
                    Content="🧹 Limpiar"
                    Width="120"
                    Height="40"
                    Margin="5"
                    Background="#F59E0B"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    FontFamily="Montserrat"
                    FontWeight="SemiBold" Click="btnLimpiar_Click"/>

                </StackPanel>

                <DataGrid Grid.Row="2"
          SelectionChanged="dgvGastos_SelectionChanged"
          x:Name="dgvGastos"
          Margin="0,10,0,0"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          IsReadOnly="True"
          HeadersVisibility="Column"
          Background="#2A175E"
          Foreground="White"
          BorderBrush="#6C63FF"
          BorderThickness="1"
          RowBackground="#2A175E"
          AlternatingRowBackground="#36206E"
          GridLinesVisibility="Horizontal">

                    <DataGrid.Resources>

                        <!-- Encabezados -->

                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#6C63FF"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontFamily" Value="Montserrat"/>
                            <Setter Property="Height" Value="35"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>

                        <!-- Celdas -->

                        <Style TargetType="DataGridCell">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="5"/>
                        </Style>

                        <!-- Filas -->

                        <Style TargetType="DataGridRow">
                            <Setter Property="Height" Value="35"/>

                            <Style.Triggers>

                                <Trigger Property="IsSelected"
                         Value="True">

                                    <Setter Property="Background"
                            Value="#6C63FF"/>

                                    <Setter Property="Foreground"
                            Value="White"/>

                                </Trigger>

                            </Style.Triggers>

                        </Style>

                    </DataGrid.Resources>

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="ID"
                            Binding="{Binding id_gastos}"
                            Width="70"/>

                        <DataGridTextColumn Header="Descripción"
                            Binding="{Binding descripcion}"
                            Width="*"/>

                        <DataGridTextColumn Header="Monto"
                            Binding="{Binding monto, StringFormat=N0}"
                            Width="120"/>

                        <DataGridTextColumn Header="Categoría"
                            Binding="{Binding categoria}"
                            Width="150"/>

                        <DataGridTextColumn Header="Fecha"
                            Binding="{Binding fecha, StringFormat=dd/MM/yyyy}"
                            Width="120"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>



    </Grid>

</UserControl>
