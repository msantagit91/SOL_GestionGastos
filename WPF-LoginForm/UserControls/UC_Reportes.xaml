<UserControl x:Class="WPF_LoginForm.UserControls.UC_Reportes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1C0E49">

    <Grid Margin="25">

        <Border Background="#2A175E"
                CornerRadius="18"
                Padding="25">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="REPORTE DE GASTOS DEL MES"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="0,0,0,20">

                    <Border Background="#1C0E49"
                            CornerRadius="12"
                            Padding="20"
                            Width="220"
                            Margin="0,0,15,0">
                        <StackPanel>
                            <TextBlock Text="Total gastado"
                                       Foreground="#00E5FF"
                                       FontWeight="Bold"
                                       FontSize="14"/>
                            <TextBlock x:Name="txtTotalGastado"
                                       Text="0"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="24"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1C0E49"
                            CornerRadius="12"
                            Padding="20"
                            Width="220">
                        <StackPanel>
                            <TextBlock Text="Cantidad de gastos"
                                       Foreground="#FF00FF"
                                       FontWeight="Bold"
                                       FontSize="14"/>
                            <TextBlock x:Name="txtCantidadGastos"
                                       Text="0"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="24"/>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <Button Grid.Column="1"
        x:Name="btnExportarPDF"
        Content="📄 PDF"
        Width="110"
        Height="35"
        Margin="15,0,0,0"
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        Cursor="Hand"
        FontSize="12"
        FontWeight="SemiBold"
        Foreground="White"
        BorderThickness="0"
        Click="btnExportarPdf_Click">

                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0"
                             EndPoint="1,1">
                            <GradientStop Color="#00E5FF"
                          Offset="0"/>
                            <GradientStop Color="#3A86FF"
                          Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>

                </Button>

                <DataGrid x:Name="dgvReporte"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Background="#1C0E49"
                          Foreground="White"
                          RowBackground="#2A175E"
                          AlternatingRowBackground="#351D73"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column">
                    

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha"
                                            Binding="{Binding fecha, StringFormat=dd/MM/yyyy}"
                                            Width="150"/>

                        <DataGridTextColumn Header="Descripción"
                                            Binding="{Binding descripcion}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Categoría"
                                            Binding="{Binding categoria}"
                                            Width="180"/>

                        <DataGridTextColumn Header="Monto"
                                            Binding="{Binding monto, StringFormat=N0}"
                                            Width="150"/>
                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

    </Grid>
</UserControl>
