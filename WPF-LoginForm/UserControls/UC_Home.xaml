<UserControl x:Class="WPF_LoginForm.UserControls.UC_Home"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WPF_LoginForm.UserControls"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid Background="#1C0E49">

        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="90"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TARJETAS SUPERIORES -->

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- TOTAL GASTADO -->

                <Border Grid.Column="0"
                        Background="#2A175E"
                        CornerRadius="12"
                        Margin="0,0,10,0"
                        Padding="15">

                    <StackPanel>

                        <TextBlock Text="TOTAL GASTADO"
                                   Foreground="WhiteSmoke"
                                   FontSize="13"
                                   FontFamily="Montserrat"/>

                        <TextBlock x:Name="txtTotalGastado"
                                   Text="₡0"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   FontFamily="Montserrat"/>

                    </StackPanel>

                </Border>

                <!-- GASTO DEL MES -->

                <Border Grid.Column="1"
                        Background="#2A175E"
                        CornerRadius="12"
                        Margin="10,0,10,0"
                        Padding="15">

                    <StackPanel>

                        <TextBlock Text="GASTO DEL MES"
                                   Foreground="WhiteSmoke"
                                   FontSize="13"
                                   FontFamily="Montserrat"/>

                        <TextBlock x:Name="txtGastoMes"
                                   Text="₡0"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   FontFamily="Montserrat"/>

                    </StackPanel>

                </Border>

                <!-- CANTIDAD DE GASTOS -->

                <Border Grid.Column="2"
                        Background="#2A175E"
                        CornerRadius="12"
                        Margin="10,0,0,0"
                        Padding="15">

                    <StackPanel>

                        <TextBlock Text="REGISTROS"
                                   Foreground="WhiteSmoke"
                                   FontSize="13"
                                   FontFamily="Montserrat"/>

                        <TextBlock x:Name="txtCantidadGastos"
                                   Text="0"
                                   Foreground="White"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   FontFamily="Montserrat"/>

                    </StackPanel>

                </Border>

            </Grid>

            <!-- SECCION INFERIOR -->

            <Grid Grid.Row="1"
                  Margin="0,20,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- PANEL GRAFICO -->

                <Border Grid.Column="0"
        Background="#2A175E"
        CornerRadius="12"
        Margin="0,0,10,0"
        Padding="20">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                   Text="GASTOS POR CATEGORÍA"
                   Foreground="White"
                   FontSize="16"
                   FontWeight="SemiBold"
                   FontFamily="Montserrat"/>

                        <lvc:PieChart Grid.Row="1"
              Series="{Binding PieSeries}"
              LegendLocation="Right"
              Margin="0,10,0,0"/>

                    </Grid>

                </Border>

                <!-- ULTIMOS GASTOS -->

                <Border Grid.Column="1"
                        Background="#2A175E"
                        CornerRadius="12"
                        Margin="10,0,0,0"
                        Padding="20">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="ÚLTIMOS GASTOS"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   FontFamily="Montserrat"/>

                        <DataGrid x:Name="dgvUltimosGastos"
                                  Grid.Row="1"
                                  Margin="0,10,0,0"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  Background="#2A175E"
                                  Foreground="White"
                                  BorderThickness="0"
                                  RowBackground="#2A175E"
                                  AlternatingRowBackground="#36206E"
                                  GridLinesVisibility="Horizontal">

                            <DataGrid.Resources>

                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#6C63FF"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Height" Value="35"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>

                            </DataGrid.Resources>

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Descripción"
                                                    Binding="{Binding descripcion}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Monto"
                                                    Binding="{Binding monto, StringFormat=N0}"
                                                    Width="90"/>

                                <DataGridTextColumn Header="Fecha"
                                                    Binding="{Binding fecha, StringFormat=dd/MM/yyyy}"
                                                    Width="90"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</UserControl>
